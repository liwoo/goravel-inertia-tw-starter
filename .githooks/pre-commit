#!/bin/bash

# Git pre-commit hook for Goravel Blog
# This hook runs before every commit

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Function to check if command exists
command_exists() {
    command -v "$1" &> /dev/null
}

# 1. Run gofmt
echo -e "${YELLOW}Running gofmt...${NC}"
GOFMT_FILES=$(gofmt -l .)
if [ -n "$GOFMT_FILES" ]; then
    echo -e "${RED}The following files need formatting:${NC}"
    echo "$GOFMT_FILES"
    echo -e "${YELLOW}Running gofmt -w -s on all files...${NC}"
    gofmt -w -s .
    echo -e "${GREEN}Files formatted. Please add them and commit again.${NC}"
    exit 1
fi

# 2. Run go mod tidy
echo -e "${YELLOW}Running go mod tidy...${NC}"
go mod tidy
if [ -n "$(git status --porcelain go.mod go.sum)" ]; then
    echo -e "${RED}go.mod or go.sum was modified by go mod tidy${NC}"
    echo -e "${YELLOW}Please add the changes and commit again.${NC}"
    exit 1
fi

# 3. Run go vet
echo -e "${YELLOW}Running go vet...${NC}"
if ! go vet ./...; then
    echo -e "${RED}go vet found issues. Please fix them.${NC}"
    exit 1
fi

# 4. Run staticcheck (if available)
if command_exists staticcheck; then
    echo -e "${YELLOW}staticcheck found but skipping due to Go 1.24 compatibility issues${NC}"
    # Skip staticcheck until it's rebuilt with Go 1.24+
else
    echo -e "${YELLOW}staticcheck not found, skipping...${NC}"
    echo -e "${YELLOW}Install with: go install honnef.co/go/tools/cmd/staticcheck@latest${NC}"
fi

# 5. Check for large files
echo -e "${YELLOW}Checking for large files...${NC}"
LARGE_FILES=$(find . -type f -size +5M -not -path "./vendor/*" -not -path "./node_modules/*" -not -path "./.git/*" -not -path "./tmp/*")
if [ -n "$LARGE_FILES" ]; then
    echo -e "${RED}Found files larger than 5MB:${NC}"
    echo "$LARGE_FILES"
    echo -e "${YELLOW}Consider using Git LFS for large files.${NC}"
    read -p "Continue anyway? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

# 5. Run quick tests (optional - can be slow)
# Uncomment the following lines to enable test running
# echo -e "${YELLOW}Running quick tests...${NC}"
# if [ -x "./run_tests.sh" ]; then
#     if ! ./run_tests.sh quick; then
#         echo -e "${RED}Tests failed${NC}"
#         exit 1
#     fi
# fi

echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
exit 0