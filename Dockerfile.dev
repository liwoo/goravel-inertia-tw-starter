# Development Dockerfile for Goravel Blog
# This dockerfile is for development use only
# It includes hot-reloading for both Go (air) and Vite

FROM golang:1.24-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache git ca-certificates tzdata nodejs npm curl bash

# Install air for hot-reloading
RUN go install github.com/air-verse/air@latest

# Install pnpm globally
RUN npm install -g pnpm

# Copy go mod files first
COPY go.mod go.sum ./
RUN go mod download

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml* ./
COPY yarn.lock* ./

# Install node dependencies
RUN if [ -f pnpm-lock.yaml ]; then \
        pnpm install; \
    elif [ -f yarn.lock ]; then \
        yarn install; \
    else \
        npm install; \
    fi

# Copy all source files
COPY . .

# Create necessary directories
RUN mkdir -p storage/logs storage/app/public storage/framework/cache storage/framework/sessions storage/framework/views && \
    chmod -R 755 storage

# Expose ports
EXPOSE 3000 5173

# Create a startup script
RUN echo '#!/bin/sh' > /start.sh && \
    echo 'echo "Starting Vite dev server..."' >> /start.sh && \
    echo 'pnpm run dev &' >> /start.sh && \
    echo 'echo "Waiting for Vite to start..."' >> /start.sh && \
    echo 'sleep 5' >> /start.sh && \
    echo 'echo "Starting Air (Go hot-reload)..."' >> /start.sh && \
    echo 'air' >> /start.sh && \
    chmod +x /start.sh

# Use the startup script
CMD ["/start.sh"]