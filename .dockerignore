# =============================================================================
# Docker ignore file for Goravel application
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
!README.md
docs/*.md
docs/screenshots/
LICENSE

# Environment files (security)
.env
.env.*
!.env.example

# Dependencies (will be installed in container)
node_modules/
vendor/

# Build artifacts
/tmp
/main
*.exe
*.dll
*.so
*.dylib
dist/

# Test files (not needed in production image)
*_test.go
tests/
coverage/
coverage.out
*.test
.nyc_output/
vitest.config.ts

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-*

# OS files
.DS_Store
Thumbs.db
*.log

# Storage (runtime data)
storage/logs/*
storage/app/public/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep

# Database files
*.sqlite
*.db
database/*.sqlite
database/*.db

# Helm charts (deployment config, not app)
helm/

# CI/CD files
.github/
.gitlab-ci.yml
Jenkinsfile
.circleci/

# Docker files (prevent recursive copy)
Dockerfile*
docker-compose*.yml
.dockerignore

# Kubernetes manifests
k8s/
*.yaml
!components.json
!package*.json
!tsconfig.json
!tailwind.config.js
!postcss.config.js
!vite.config.ts

# Scripts not needed in production
*.sh
Makefile

# Temporary and cache files
*.tmp
*.temp
*.cache
.cache/

# Go specific
go.work
go.work.sum

# Node specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
yarn.lock
pnpm-lock.yaml
package-lock.json
