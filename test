#!/bin/bash

# Colors for output
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${2}${1}${NC}"
}

# Ensure we're in the right directory
if [ ! -f "go.mod" ]; then
    print_status "Error: This script must be run from the project root directory" "$RED"
    exit 1
fi

# Create required directories/files
mkdir -p resources/views
touch resources/views/dummy.tmpl

# Default to all tests
TEST_PATH="./tests/..."
TEST_TYPE="all"

# Parse arguments
if [ "$1" == "feature" ]; then
    TEST_PATH="./tests/feature/..."
    TEST_TYPE="feature"
elif [ "$1" == "integration" ]; then
    TEST_PATH="./tests/integration/..."
    TEST_TYPE="integration"
elif [ "$1" == "unit" ]; then
    TEST_PATH="./tests/unit/..."
    TEST_TYPE="unit"
elif [ "$1" == "help" ] || [ "$1" == "-h" ] || [ "$1" == "--help" ]; then
    echo "Usage: ./test [type]"
    echo ""
    echo "Types:"
    echo "  feature     - Run feature tests only"
    echo "  integration - Run integration tests only"
    echo "  unit        - Run unit tests only"
    echo "  (none)      - Run all tests"
    echo ""
    echo "Examples:"
    echo "  ./test              # Run all tests"
    echo "  ./test feature      # Run feature tests only"
    echo "  ./test unit         # Run unit tests only"
    exit 0
fi

print_status "🧪 Running $TEST_TYPE tests..." "$YELLOW"
echo ""

# Run tests with timeout and capture output
APP_ENV=testing go test -v $TEST_PATH -timeout=10m 2>&1 | tee /tmp/test_output.log

# Check if tests passed
if [ ${PIPESTATUS[0]} -eq 0 ]; then
    print_status "✅ All $TEST_TYPE tests passed!" "$GREEN"
    
    # Show summary
    echo ""
    print_status "📊 Test Summary:" "$YELLOW"
    grep -E "^(ok|FAIL)" /tmp/test_output.log | sort
else
    print_status "❌ Some tests failed!" "$RED"
    
    # Show failed tests
    echo ""
    print_status "Failed tests:" "$RED"
    grep -E "^--- FAIL:" /tmp/test_output.log
fi

# Clean up
rm -f /tmp/test_output.log