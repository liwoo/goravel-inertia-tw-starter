import React, { useState, forwardRef, useImperativeHandle, useEffect } from 'react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Textarea } from '@/components/ui/textarea';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Sme, SmeCreateData, SmeUpdateData } from '@/types/sme';
import {
  MapPin, FileText, User, FolderOpen, Phone, Mail, Building2, Globe,
  ChevronRight, ChevronLeft, Plus, Trash2, Calendar, X, Check, Save
} from 'lucide-react';
import { Separator } from '@/components/ui/separator';
import { Progress } from '@/components/ui/progress';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Checkbox } from '@/components/ui/checkbox';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { DISTRICTS, DISTRICT_NAMES } from '@/constants/districts';
import { NATIONALITY_OPTIONS } from '@/types/nationalities';
import { GENDER_OPTIONS } from '@/types/gender';
import { EDUCATION_OPTIONS } from '@/types/education';
import { MALAWIAN_STATUS_OPTIONS } from '@/types/malawian-status';
import {
  Popover,
  PopoverContent,
  PopoverTrigger,
} from '@/components/ui/popover';
import axios from 'axios';
import { snakefiyKeys, camelifyKeys } from "@/lib/utils";
import {
  validateMalawiPhone,
  validateBusinessRegistration,
  validateTIN,
  validateNationalID,
  formatMalawiPhone,
  formatBusinessRegistration,
  VALIDATION_MESSAGES,
  EXAMPLE_FORMATS
} from '@/lib/malawi-validators';
import {
  FormalisationFormData,
  DEFAULT_FORMALISATION_DATA,
  BusinessFormalisation,
  BusinessFormalisationUpdateData
} from '@/types/business_formalisation';
import { Switch } from '@/components/ui/switch';
import { cn } from '@/lib/utils';

// Type definitions for related data
interface PrimaryOwnerData {
  id?: number;
  firstName: string;
  lastName: string;
  otherNames?: string;
  nationality: string;
  nationalIdNumber: string;
  dateOfBirth?: string;
  gender: string;
  educationLevel: string;
  malawianStatus: string;
  hasSpecialNeeds: boolean;
  phoneNumber: string;
  landlineNumber?: string;
  email?: string;
  physicalAddress?: string;
  postalAddress?: string;
  district?: string;
  traditionalAuthority?: string;
  altContactName?: string;
  altContactRelationship?: string;
  altContactPhone?: string;
}

interface AdditionalMemberData {
  id?: number;
  firstName: string;
  lastName: string;
  otherNames?: string;
  nationality: string;
  nationalIdNumber: string;
  dateOfBirth?: string;
  email?: string;
  phoneNumber: string;
  isIntern: boolean;
  isPartTime: boolean;
}

// Define the form modes
type FormMode = 'create' | 'edit';

// Define the sections as a constant
const SECTIONS = {
  BUSINESS_INFO: 'business-info',
  PRIMARY_OWNER: 'primary-owner',
  FORMALIZATION: 'formalization',
  ADDITIONAL_MEMBERS: 'additional-members',
  REVIEW: 'review'
} as const;

type SectionKey = typeof SECTIONS[keyof typeof SECTIONS];

// Define steps for wizard mode
const WIZARD_STEPS = [
  { id: 1, key: SECTIONS.BUSINESS_INFO, name: 'Business Information', description: 'Basic SME details' },
  { id: 2, key: SECTIONS.PRIMARY_OWNER, name: 'Primary Owner', description: 'Business owner information' },
  { id: 3, key: SECTIONS.FORMALIZATION, name: 'Formalization', description: 'Business formalization status' },
  { id: 4, key: SECTIONS.ADDITIONAL_MEMBERS, name: 'Additional Members', description: 'Optional team members' },
  { id: 5, key: SECTIONS.REVIEW, name: 'Review', description: 'Review and submit' },
];

// Define tabs for edit mode (without review)
const EDIT_TABS = [
  { key: SECTIONS.BUSINESS_INFO, name: 'Business Information', icon: Building2 },
  { key: SECTIONS.PRIMARY_OWNER, name: 'Primary Owner', icon: User },
  { key: SECTIONS.FORMALIZATION, name: 'Formalization', icon: FileText },
  { key: SECTIONS.ADDITIONAL_MEMBERS, name: 'Team Members', icon: User },
];

interface SmeUnifiedFormProps {
  mode: FormMode;
  // Data for pre-population in edit mode
  sme?: Sme;
  primaryOwner?: PrimaryOwnerData;
  formalization?: BusinessFormalisation;
  additionalMembers?: AdditionalMemberData[];
  // Callbacks
  onSuccess: (message: string) => void;
  onError?: (error: any) => void;
  onCancel?: () => void;
  isLoading?: boolean;
  setIsSaving?: (saving: boolean) => void;
}

export const SmeUnifiedForm = forwardRef<any, SmeUnifiedFormProps>(({
  mode,
  sme,
  primaryOwner: initialPrimaryOwner,
  formalization: initialFormalization,
  additionalMembers: initialAdditionalMembers = [],
  onSuccess,
  onError,
  onCancel,
  isLoading = false,
  setIsSaving
}, ref) => {
  // Navigation state
  const [currentStep, setCurrentStep] = useState(1);
  const [activeTab, setActiveTab] = useState<SectionKey>(SECTIONS.BUSINESS_INFO);
  const [errors, setErrors] = useState<Record<string, string>>({});

  // Track which sections have been modified in edit mode
  const [modifiedSections, setModifiedSections] = useState<Set<SectionKey>>(new Set());

  // Business Information state
  const [businessData, setBusinessData] = useState<SmeCreateData | SmeUpdateData>(() => {
    if (mode === 'edit' && sme) {
      // Convert snake_case from backend to camelCase for frontend
      const camelSme = camelifyKeys(sme);
      return {
        name: camelSme.name,
        registrationNumber: camelSme.registrationNumber || undefined,
        taxIdentificationNumber: camelSme.taxIdentificationNumber || undefined,
        operationalStartDate: camelSme.operationalStartDate || '',
        businessCategory: camelSme.businessCategory,
        sector: camelSme.sector,
        subSector: camelSme.subSector || undefined,
        businessDescription: camelSme.businessDescription || undefined,
        contactPhone: camelSme.contactPhone,
        contactEmail: camelSme.contactEmail,
        physicalAddress: camelSme.physicalAddress || undefined,
        postalAddress: camelSme.postalAddress || undefined,
        website: camelSme.website || undefined,
        district: camelSme.district || undefined,
        traditionalAuthority: camelSme.traditionalAuthority || undefined,
        businessImprovementAspects: Array.isArray(camelSme.businessImprovementAspects)
          ? camelSme.businessImprovementAspects
          : (camelSme.businessImprovementAspects ? camelSme.businessImprovementAspects.split(',') : []),
        businessAccessedFinancing: Array.isArray(camelSme.businessAccessedFinancing)
          ? camelSme.businessAccessedFinancing
          : (camelSme.businessAccessedFinancing ? camelSme.businessAccessedFinancing.split(',') : []),
      };
    }
    return {
      name: '',
      registrationNumber: undefined,
      taxIdentificationNumber: undefined,
      operationalStartDate: '',
      businessCategory: '',
      sector: '',
      subSector: undefined,
      businessDescription: undefined,
      contactPhone: '',
      contactEmail: '',
      physicalAddress: undefined,
      postalAddress: undefined,
      website: undefined,
      district: undefined,
      traditionalAuthority: undefined,
      businessImprovementAspects: [],
      businessAccessedFinancing: [],
    };
  });

  // Primary Owner state
  const [primaryOwner, setPrimaryOwner] = useState<PrimaryOwnerData>(() => {
    if (mode === 'edit' && initialPrimaryOwner) {
      return initialPrimaryOwner;
    }
    return {
      firstName: '',
      lastName: '',
      otherNames: undefined,
      nationality: '',
      nationalIdNumber: '',
      dateOfBirth: undefined,
      gender: '',
      educationLevel: '',
      malawianStatus: '',
      hasSpecialNeeds: false,
      phoneNumber: '',
      landlineNumber: undefined,
      email: undefined,
      physicalAddress: undefined,
      postalAddress: undefined,
      district: undefined,
      traditionalAuthority: undefined,
      altContactName: undefined,
      altContactRelationship: undefined,
      altContactPhone: undefined,
    };
  });

  // Formalization state
  const [formalizationData, setFormalizationData] = useState<FormalisationFormData>(() => {
    if (mode === 'edit' && initialFormalization) {
      return {
        hasBankAccount: initialFormalization.hasBankAccount,
        hasTaxClarification: initialFormalization.hasTaxClarification,
        isRegisteredForVat: initialFormalization.isRegisteredForVat,
        isMemberOfAssociation: initialFormalization.isMemberOfAssociation,
        isAffiliated: initialFormalization.isAffiliated,
        hasExportLicense: initialFormalization.hasExportLicense,
        hasAccessedBds: initialFormalization.hasAccessedBds,
        annualTurnover: initialFormalization.annualTurnover?.toString() || '',
        estimatedValueOfAssets: initialFormalization.estimatedValueOfAssets?.toString() || '',
      };
    }
    return DEFAULT_FORMALISATION_DATA;
  });

  // Additional Members state
  const [additionalMembers, setAdditionalMembers] = useState<AdditionalMemberData[]>(initialAdditionalMembers);
  const [memberActiveTab, setMemberActiveTab] = useState<string>('new-member');
  const [newMember, setNewMember] = useState<AdditionalMemberData>({
    firstName: '',
    lastName: '',
    otherNames: undefined,
    nationality: '',
    nationalIdNumber: '',
    dateOfBirth: undefined,
    email: undefined,
    phoneNumber: '',
    isIntern: false,
    isPartTime: false,
  });

  // Multi-input helpers for arrays
  const [improvementAspect, setImprovementAspect] = useState('');
  const [financingSource, setFinancingSource] = useState('');

  // Config options from API
  const [improvementOptions, setImprovementOptions] = useState<string[]>([]);
  const [financingOptions, setFinancingOptions] = useState<string[]>([]);
  const [sectorOptions, setSectorOptions] = useState<string[]>([]);
  const [categoryOptions, setCategoryOptions] = useState<string[]>([]);
  const [improvementPopoverOpen, setImprovementPopoverOpen] = useState(false);
  const [financingPopoverOpen, setFinancingPopoverOpen] = useState(false);
  const [loadingConfigs, setLoadingConfigs] = useState(false);

  const progress = mode === 'create' ? (currentStep / WIZARD_STEPS.length) * 100 : 0;

  // Track modifications in edit mode
  const trackModification = (section: SectionKey) => {
    if (mode === 'edit') {
      setModifiedSections(prev => {
        if (!prev.has(section)) {
          return new Set([...prev, section]);
        }
        return prev;
      });
    }
  };

  // Fetch config options on mount
  useEffect(() => {
    const fetchConfigOptions = async () => {
      setLoadingConfigs(true);
      try {
        const [improvementRes, financingRes, sectorRes, categoryRes] = await Promise.all([
          axios.get('/api/configs', {
            params: {
              config_type: 'Improvement Aspects',
              pageSize: 100,
              sort: 'name',
              direction: 'ASC'
            }
          }),
          axios.get('/api/configs', {
            params: {
              config_type: 'Financing',
              pageSize: 100,
              sort: 'name',
              direction: 'ASC'
            }
          }),
          axios.get('/api/configs', {
            params: {
              config_type: 'Sectors',
              pageSize: 100,
              sort: 'name',
              direction: 'ASC'
            }
          }),
          axios.get('/api/configs', {
            params: {
              config_type: 'Business Categories',
              pageSize: 100,
              sort: 'name',
              direction: 'ASC'
            }
          })
        ]);

        const improvementData = improvementRes.data.data?.data || [];
        const financingData = financingRes.data.data?.data || [];
        const sectorData = sectorRes.data.data?.data || [];
        const categoryData = categoryRes.data.data?.data || [];

        const improvements = improvementData.map((config: any) => config.name);
        const financing = financingData.map((config: any) => config.name);
        const sectors = sectorData.map((config: any) => config.name);
        const categories = categoryData.map((config: any) => config.name);

        setImprovementOptions(improvements);
        setFinancingOptions(financing);
        setSectorOptions(sectors);
        setCategoryOptions(categories);
      } catch (error) {
        console.error('Error fetching config options:', error);
      } finally {
        setLoadingConfigs(false);
      }
    };

    fetchConfigOptions();
  }, []);

  // Validation functions
  const validateBusinessInfo = () => {
    const newErrors: Record<string, string> = {};
    if (!businessData.name) newErrors.name = 'Business Name is required';
    if (!businessData.businessCategory) newErrors.businessCategory = 'Business Category is required';
    if (!businessData.sector) newErrors.sector = 'Sector is required';
    if (!businessData.contactPhone) {
      newErrors.contactPhone = 'Contact Phone is required';
    } else if (!validateMalawiPhone(businessData.contactPhone)) {
      newErrors.contactPhone = VALIDATION_MESSAGES.PHONE;
    }
    if (!businessData.contactEmail) newErrors.contactEmail = 'Contact Email is required';

    if (businessData.registrationNumber && !validateBusinessRegistration(businessData.registrationNumber)) {
      newErrors.registrationNumber = VALIDATION_MESSAGES.BUSINESS_REG;
    }

    if (businessData.taxIdentificationNumber && !validateTIN(businessData.taxIdentificationNumber)) {
      newErrors.taxIdentificationNumber = VALIDATION_MESSAGES.TIN;
    }

    if (mode === 'create') {
      if (businessData.businessImprovementAspects?.length === 0) {
        newErrors.businessImprovementAspects = 'At least one improvement aspect is required';
      }
      if (businessData.businessAccessedFinancing?.length === 0) {
        newErrors.businessAccessedFinancing = 'At least one financing source is required';
      }
    }

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const validatePrimaryOwner = () => {
    const newErrors: Record<string, string> = {};
    if (!primaryOwner.firstName) newErrors.firstName = 'First Name is required';
    if (!primaryOwner.lastName) newErrors.lastName = 'Last Name is required';
    if (!primaryOwner.nationality) newErrors.nationality = 'Nationality is required';
    if (!primaryOwner.nationalIdNumber) {
      newErrors.nationalIdNumber = 'National ID is required';
    } else if (!validateNationalID(primaryOwner.nationalIdNumber)) {
      newErrors.nationalIdNumber = VALIDATION_MESSAGES.NATIONAL_ID;
    }
    if (mode === 'create' && !primaryOwner.dateOfBirth) {
      newErrors.dateOfBirth = 'Date of Birth is required';
    }
    if (!primaryOwner.gender) newErrors.gender = 'Gender is required';
    if (!primaryOwner.educationLevel) newErrors.educationLevel = 'Education Level is required';
    if (!primaryOwner.malawianStatus) newErrors.malawianStatus = 'Malawian Status is required';
    if (!primaryOwner.phoneNumber) {
      newErrors.phoneNumber = 'Phone Number is required';
    } else if (!validateMalawiPhone(primaryOwner.phoneNumber)) {
      newErrors.phoneNumber = VALIDATION_MESSAGES.PHONE;
    }

    if (primaryOwner.landlineNumber && !validateMalawiPhone(primaryOwner.landlineNumber)) {
      newErrors.landlineNumber = VALIDATION_MESSAGES.PHONE;
    }

    if (primaryOwner.altContactPhone && !validateMalawiPhone(primaryOwner.altContactPhone)) {
      newErrors.altContactPhone = VALIDATION_MESSAGES.PHONE;
    }

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const validateFormalization = () => {
    const newErrors: Record<string, string> = {};

    if (formalizationData.annualTurnover && isNaN(parseFloat(formalizationData.annualTurnover))) {
      newErrors.annualTurnover = 'Annual turnover must be a valid number';
    }

    if (formalizationData.estimatedValueOfAssets && isNaN(parseFloat(formalizationData.estimatedValueOfAssets))) {
      newErrors.estimatedValueOfAssets = 'Estimated value of assets must be a valid number';
    }

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  // Navigation handlers for wizard mode
  const handleNext = () => {
    let isValid = true;

    if (currentStep === 1) {
      isValid = validateBusinessInfo();
    } else if (currentStep === 2) {
      isValid = validatePrimaryOwner();
    } else if (currentStep === 3) {
      isValid = validateFormalization();
    }

    if (isValid && currentStep < WIZARD_STEPS.length) {
      setCurrentStep(currentStep + 1);
      setErrors({});
    }
  };

  const handlePrevious = () => {
    if (currentStep > 1) {
      setCurrentStep(currentStep - 1);
      setErrors({});
    }
  };

  // Helper functions for array fields
  const addImprovementAspect = (value?: string) => {
    const aspectToAdd = value || improvementAspect.trim();
    if (aspectToAdd && !businessData.businessImprovementAspects?.includes(aspectToAdd)) {
      setBusinessData({
        ...businessData,
        businessImprovementAspects: [...(businessData.businessImprovementAspects || []), aspectToAdd]
      });
      trackModification(SECTIONS.BUSINESS_INFO);
      setImprovementAspect('');
    }
  };

  const removeImprovementAspect = (aspectToRemove: string) => {
    setBusinessData({
      ...businessData,
      businessImprovementAspects: businessData.businessImprovementAspects?.filter(a => a !== aspectToRemove) || []
    });
    trackModification(SECTIONS.BUSINESS_INFO);
  };

  const addFinancingSource = (value?: string) => {
    const sourceToAdd = value || financingSource.trim();
    if (sourceToAdd && !businessData.businessAccessedFinancing?.includes(sourceToAdd)) {
      setBusinessData({
        ...businessData,
        businessAccessedFinancing: [...(businessData.businessAccessedFinancing || []), sourceToAdd]
      });
      trackModification(SECTIONS.BUSINESS_INFO);
      setFinancingSource('');
    }
  };

  const removeFinancingSource = (sourceToRemove: string) => {
    setBusinessData({
      ...businessData,
      businessAccessedFinancing: businessData.businessAccessedFinancing?.filter(s => s !== sourceToRemove) || []
    });
    trackModification(SECTIONS.BUSINESS_INFO);
  };

  const addMember = () => {
    if (newMember.firstName && newMember.lastName && newMember.nationalIdNumber && newMember.phoneNumber) {
      const newMembersList = [...additionalMembers, newMember];
      setAdditionalMembers(newMembersList);
      trackModification(SECTIONS.ADDITIONAL_MEMBERS);
      setMemberActiveTab(`member-${newMembersList.length - 1}`);
      setNewMember({
        firstName: '',
        lastName: '',
        otherNames: '',
        nationality: '',
        nationalIdNumber: '',
        dateOfBirth: '',
        email: '',
        phoneNumber: '',
        isIntern: false,
        isPartTime: false,
      });
    }
  };

  const removeMember = (index: number) => {
    setAdditionalMembers(additionalMembers.filter((_, i) => i !== index));
    trackModification(SECTIONS.ADDITIONAL_MEMBERS);
    setMemberActiveTab('new-member');
  };

  // Create mode submission handler
  const handleCreateSubmit = async () => {
    setIsSaving?.(true);
    setErrors({});

    try {
      // Step 1: Create SME
      const smeResponse = await fetch('/api/smes', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify(snakefiyKeys(businessData)),
      });

      if (!smeResponse.ok) {
        const errorData = await smeResponse.json().catch(() => ({}));
        onError?.(errorData);
        return;
      }

      const smeData = await smeResponse.json();
      const smeId = smeData.data.id;

      // Step 2: Create Primary Business Owner
      const primaryOwnerResponse = await fetch('/api/primary-business-owners', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({
          ...snakefiyKeys(primaryOwner),
          "sme_id": smeId,
        }),
      });

      if (!primaryOwnerResponse.ok) {
        const errorData = await primaryOwnerResponse.json().catch(() => ({}));
        onError?.(errorData);
        // Remove SME if relationship creation fails
        await axios.delete(`/api/smes/${smeId}`).catch(console.error);
        return;
      }

      // Step 3: Create Business Formalization
      const formalizationPayload = {
        sme_id: smeId,
        has_bank_account: formalizationData.hasBankAccount,
        has_tax_clarification: formalizationData.hasTaxClarification,
        is_registered_for_vat: formalizationData.isRegisteredForVat,
        is_member_of_association: formalizationData.isMemberOfAssociation,
        is_affiliated: formalizationData.isAffiliated,
        has_export_license: formalizationData.hasExportLicense,
        has_accessed_bds: formalizationData.hasAccessedBds,
        annual_turnover: formalizationData.annualTurnover ? parseFloat(formalizationData.annualTurnover) : 0,
        estimated_value_of_assets: formalizationData.estimatedValueOfAssets ? parseFloat(formalizationData.estimatedValueOfAssets) : 0,
      };

      const formalizationResponse = await fetch('/api/business-formalisations', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify(formalizationPayload),
      });

      if (!formalizationResponse.ok) {
        const errorData = await formalizationResponse.json().catch(() => ({}));
        console.error('Failed to create formalization data:', errorData);
      }

      // Step 4: Create Additional Business Members (if any)
      if (additionalMembers.length > 0) {
        const memberPromises = additionalMembers.map(member =>
          fetch('/api/additional_business_members', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({
              ...snakefiyKeys(member),
              "sme_id": smeId,
            }),
          })
        );

        await Promise.all(memberPromises);
      }

      onSuccess('SME and related information created successfully');
    } catch (error: any) {
      onError?.(error.message || 'Failed to create SME');
    } finally {
      setIsSaving?.(false);
    }
  };

  // Edit mode submission handlers
  const handleSaveBusinessInfo = async (standalone = true) => {
    if (!validateBusinessInfo()) {
      if (standalone) throw new Error('Validation failed');
      return;
    }

    if (standalone) setIsSaving?.(true);
    try {
      const response = await fetch(`/api/smes/${sme?.id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify(snakefiyKeys(businessData)),
      });

      if (response.ok) {
        if (standalone) onSuccess('Business information updated successfully');
        setModifiedSections(new Set([...modifiedSections].filter(s => s !== SECTIONS.BUSINESS_INFO)));
      } else {
        const errorData = await response.json().catch(() => ({}));
        throw errorData;
      }
    } catch (error) {
      if (standalone) onError?.(error);
      throw error;
    } finally {
      if (standalone) setIsSaving?.(false);
    }
  };

  const handleSavePrimaryOwner = async (standalone = true) => {
    if (!validatePrimaryOwner()) {
      if (standalone) throw new Error('Validation failed');
      return;
    }

    if (standalone) setIsSaving?.(true);
    try {
      const url = primaryOwner.id
        ? `/api/primary-business-owners/${primaryOwner.id}`
        : '/api/primary-business-owners';

      const method = primaryOwner.id ? 'PUT' : 'POST';

      const payload = primaryOwner.id
        ? snakefiyKeys(primaryOwner)
        : { ...snakefiyKeys(primaryOwner), sme_id: sme?.id };

      const response = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify(payload),
      });

      if (response.ok) {
        if (standalone) onSuccess('Primary owner information updated successfully');
        setModifiedSections(new Set([...modifiedSections].filter(s => s !== SECTIONS.PRIMARY_OWNER)));
      } else {
        const errorData = await response.json().catch(() => ({}));
        throw errorData;
      }
    } catch (error) {
      if (standalone) onError?.(error);
      throw error;
    } finally {
      if (standalone) setIsSaving?.(false);
    }
  };

  const handleSaveFormalization = async (standalone = true) => {
    if (!validateFormalization()) {
      if (standalone) throw new Error('Validation failed');
      return;
    }

    if (standalone) setIsSaving?.(true);
    try {
      const payload: BusinessFormalisationUpdateData = {
        hasBankAccount: formalizationData.hasBankAccount,
        hasTaxClarification: formalizationData.hasTaxClarification,
        isRegisteredForVat: formalizationData.isRegisteredForVat,
        isMemberOfAssociation: formalizationData.isMemberOfAssociation,
        isAffiliated: formalizationData.isAffiliated,
        hasExportLicense: formalizationData.hasExportLicense,
        hasAccessedBds: formalizationData.hasAccessedBds,
        annualTurnover: formalizationData.annualTurnover ? parseFloat(formalizationData.annualTurnover) : 0,
        estimatedValueOfAssets: formalizationData.estimatedValueOfAssets ? parseFloat(formalizationData.estimatedValueOfAssets) : 0,
      };

      const url = initialFormalization?.id
        ? `/api/business-formalisations/${initialFormalization.id}`
        : '/api/business-formalisations';

      const method = initialFormalization?.id ? 'PUT' : 'POST';

      const response = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify(
          initialFormalization?.id
            ? snakefiyKeys(payload)
            : { ...snakefiyKeys(payload), sme_id: sme?.id }
        ),
      });

      if (response.ok) {
        if (standalone) onSuccess('Formalization information updated successfully');
        setModifiedSections(new Set([...modifiedSections].filter(s => s !== SECTIONS.FORMALIZATION)));
      } else {
        const errorData = await response.json().catch(() => ({}));
        throw errorData;
      }
    } catch (error) {
      if (standalone) onError?.(error);
      throw error;
    } finally {
      if (standalone) setIsSaving?.(false);
    }
  };

  const handleSaveAllChanges = async () => {
    if (modifiedSections.size === 0) {
      onSuccess('No changes to save');
      return;
    }

    setIsSaving?.(true);
    const promises: Promise<void>[] = [];

    if (modifiedSections.has(SECTIONS.BUSINESS_INFO)) {
      promises.push(handleSaveBusinessInfo(false));
    }
    if (modifiedSections.has(SECTIONS.PRIMARY_OWNER)) {
      promises.push(handleSavePrimaryOwner(false));
    }
    if (modifiedSections.has(SECTIONS.FORMALIZATION)) {
      promises.push(handleSaveFormalization(false));
    }

    try {
      await Promise.all(promises);
      onSuccess('All changes saved successfully');
      setModifiedSections(new Set());
    } catch (error) {
      onError?.(error);
    } finally {
      setIsSaving?.(false);
    }
  };

  // Expose handleSubmit to parent component
  useImperativeHandle(ref, () => ({
    handleSubmit: () => {
      if (mode === 'create') {
        if (currentStep === WIZARD_STEPS.length) {
          handleCreateSubmit();
        } else {
          handleNext();
        }
      } else {
        handleSaveAllChanges();
      }
    }
  }));

  // Render business information section
  const renderBusinessInfoSection = () => (
