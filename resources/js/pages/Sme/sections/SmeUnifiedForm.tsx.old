                  trackModification(SECTIONS.PRIMARY_OWNER);
                }}
                placeholder={`e.g., ${EXAMPLE_FORMATS.PHONE}`}
                className={errors.landlineNumber ? 'border-destructive' : ''}
              />
              {errors.landlineNumber && <p className="text-sm text-destructive">{errors.landlineNumber}</p>}
            </div>

            <div className="space-y-2">
              <Label htmlFor="email">Email</Label>
              <Input
                id="email"
                type="email"
                value={primaryOwner.email}
                onChange={(e) => {
                  setPrimaryOwner({ ...primaryOwner, email: e.target.value });
                  trackModification(SECTIONS.PRIMARY_OWNER);
                }}
                placeholder="Enter email"
              />
            </div>

            <div className="space-y-2">
              <Label htmlFor="ownerDistrict">District</Label>
              <Select
                value={primaryOwner.district}
                onValueChange={(value) => {
                  setPrimaryOwner({ ...primaryOwner, district: value });
                  trackModification(SECTIONS.PRIMARY_OWNER);
                }}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Select district" />
                </SelectTrigger>
                <SelectContent>
                  {DISTRICT_NAMES.map((district) => (
                    <SelectItem key={district} value={district}>
                      {district}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            <div className="space-y-2">
              <Label htmlFor="ownerTraditionalAuthority">Traditional Authority</Label>
              <Input
                id="ownerTraditionalAuthority"
                value={primaryOwner.traditionalAuthority}
                onChange={(e) => {
                  setPrimaryOwner({ ...primaryOwner, traditionalAuthority: e.target.value });
                  trackModification(SECTIONS.PRIMARY_OWNER);
                }}
                placeholder="Enter TA"
              />
            </div>
          </div>

          <div className="space-y-2">
            <Label htmlFor="ownerPhysicalAddress">Physical Address</Label>
            <Textarea
              id="ownerPhysicalAddress"
              value={primaryOwner.physicalAddress}
              onChange={(e) => {
                setPrimaryOwner({ ...primaryOwner, physicalAddress: e.target.value });
                trackModification(SECTIONS.PRIMARY_OWNER);
              }}
              placeholder="Enter physical address"
              rows={2}
            />
          </div>

          <div className="space-y-2">
            <Label htmlFor="ownerPostalAddress">Postal Address</Label>
            <Textarea
              id="ownerPostalAddress"
              value={primaryOwner.postalAddress}
              onChange={(e) => {
                setPrimaryOwner({ ...primaryOwner, postalAddress: e.target.value });
                trackModification(SECTIONS.PRIMARY_OWNER);
              }}
              placeholder="Enter postal address"
              rows={2}
            />
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Alternative Contact</CardTitle>
          <CardDescription>Emergency contact person (optional)</CardDescription>
        </CardHeader>
        <CardContent className="space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="space-y-2">
              <Label htmlFor="altContactName">Contact Name</Label>
              <Input
                id="altContactName"
                value={primaryOwner.altContactName}
                onChange={(e) => {
                  setPrimaryOwner({ ...primaryOwner, altContactName: e.target.value });
                  trackModification(SECTIONS.PRIMARY_OWNER);
                }}
                placeholder="Enter contact name"
              />
            </div>

            <div className="space-y-2">
              <Label htmlFor="altContactRelationship">Relationship</Label>
              <Input
                id="altContactRelationship"
                value={primaryOwner.altContactRelationship}
                onChange={(e) => {
                  setPrimaryOwner({ ...primaryOwner, altContactRelationship: e.target.value });
                  trackModification(SECTIONS.PRIMARY_OWNER);
                }}
                placeholder="Enter relationship"
              />
            </div>

            <div className="space-y-2">
              <Label htmlFor="altContactPhone">Contact Phone</Label>
              <Input
                id="altContactPhone"
                value={primaryOwner.altContactPhone}
                onChange={(e) => {
                  const formatted = formatMalawiPhone(e.target.value);
                  setPrimaryOwner({ ...primaryOwner, altContactPhone: formatted });
                  trackModification(SECTIONS.PRIMARY_OWNER);
                }}
                placeholder={`e.g., ${EXAMPLE_FORMATS.PHONE}`}
                className={errors.altContactPhone ? 'border-destructive' : ''}
              />
              {errors.altContactPhone && <p className="text-sm text-destructive">{errors.altContactPhone}</p>}
            </div>
          </div>
        </CardContent>
      </Card>

      {mode === 'edit' && modifiedSections.has(SECTIONS.PRIMARY_OWNER) && (
        <div className="flex justify-end">
          <Button onClick={handleSavePrimaryOwner} disabled={isLoading}>
            <Save className="h-4 w-4 mr-2" />
            Save Primary Owner Information
          </Button>
        </div>
      )}
    </div>
  );

  // Render formalization section
  const renderFormalizationSection = () => (
    <div className="space-y-6">
      <Card>
        <CardHeader>
          <CardTitle>Business Formalization Status</CardTitle>
          <CardDescription>
            Indicate the formal compliance and registration status of your business
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-6">
          <div className="space-y-4">
            <h3 className="font-semibold">Registration & Compliance</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div className="flex items-center justify-between space-x-2">
                <Label htmlFor="hasBankAccount">Has Bank Account</Label>
                <Switch
                  id="hasBankAccount"
                  checked={formalizationData.hasBankAccount}
                  onCheckedChange={(checked) => {
                    setFormalizationData({ ...formalizationData, hasBankAccount: checked });
                    trackModification(SECTIONS.FORMALIZATION);
                  }}
                />
              </div>

              <div className="flex items-center justify-between space-x-2">
                <Label htmlFor="hasTaxClarification">Has Tax Clarification Certificate</Label>
                <Switch
                  id="hasTaxClarification"
                  checked={formalizationData.hasTaxClarification}
                  onCheckedChange={(checked) => {
                    setFormalizationData({ ...formalizationData, hasTaxClarification: checked });
                    trackModification(SECTIONS.FORMALIZATION);
                  }}
                />
              </div>

              <div className="flex items-center justify-between space-x-2">
                <Label htmlFor="isRegisteredForVat">Registered for VAT</Label>
                <Switch
                  id="isRegisteredForVat"
                  checked={formalizationData.isRegisteredForVat}
                  onCheckedChange={(checked) => {
                    setFormalizationData({ ...formalizationData, isRegisteredForVat: checked });
                    trackModification(SECTIONS.FORMALIZATION);
                  }}
                />
              </div>

              <div className="flex items-center justify-between space-x-2">
                <Label htmlFor="hasExportLicense">Has Export License</Label>
                <Switch
                  id="hasExportLicense"
                  checked={formalizationData.hasExportLicense}
                  onCheckedChange={(checked) => {
                    setFormalizationData({ ...formalizationData, hasExportLicense: checked });
                    trackModification(SECTIONS.FORMALIZATION);
                  }}
                />
              </div>
            </div>
          </div>

          <Separator />

          <div className="space-y-4">
            <h3 className="font-semibold">Business Associations & Support</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div className="flex items-center justify-between space-x-2">
                <Label htmlFor="isMemberOfAssociation">Member of Business Association</Label>
                <Switch
                  id="isMemberOfAssociation"
                  checked={formalizationData.isMemberOfAssociation}
                  onCheckedChange={(checked) => {
                    setFormalizationData({ ...formalizationData, isMemberOfAssociation: checked });
                    trackModification(SECTIONS.FORMALIZATION);
                  }}
                />
              </div>

              <div className="flex items-center justify-between space-x-2">
                <Label htmlFor="isAffiliated">Is Affiliated</Label>
                <Switch
                  id="isAffiliated"
                  checked={formalizationData.isAffiliated}
                  onCheckedChange={(checked) => {
                    setFormalizationData({ ...formalizationData, isAffiliated: checked });
                    trackModification(SECTIONS.FORMALIZATION);
                  }}
                />
              </div>

              <div className="flex items-center justify-between space-x-2">
                <Label htmlFor="hasAccessedBds">Has Accessed Business Development Services</Label>
                <Switch
                  id="hasAccessedBds"
                  checked={formalizationData.hasAccessedBds}
                  onCheckedChange={(checked) => {
                    setFormalizationData({ ...formalizationData, hasAccessedBds: checked });
                    trackModification(SECTIONS.FORMALIZATION);
                  }}
                />
              </div>
            </div>
          </div>

          <Separator />

          <div className="space-y-4">
            <h3 className="font-semibold">Financial Information</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label htmlFor="annualTurnover">Annual Turnover (MWK)</Label>
                <Input
                  id="annualTurnover"
                  type="text"
                  value={formalizationData.annualTurnover}
                  onChange={(e) => {
                    setFormalizationData({ ...formalizationData, annualTurnover: e.target.value });
                    trackModification(SECTIONS.FORMALIZATION);
                  }}
                  placeholder="e.g., 5000000"
                  className={errors.annualTurnover ? 'border-destructive' : ''}
                />
                {errors.annualTurnover && <p className="text-sm text-destructive">{errors.annualTurnover}</p>}
              </div>

              <div className="space-y-2">
                <Label htmlFor="estimatedValueOfAssets">Estimated Value of Assets (MWK)</Label>
                <Input
                  id="estimatedValueOfAssets"
                  type="text"
                  value={formalizationData.estimatedValueOfAssets}
                  onChange={(e) => {
                    setFormalizationData({ ...formalizationData, estimatedValueOfAssets: e.target.value });
                    trackModification(SECTIONS.FORMALIZATION);
                  }}
                  placeholder="e.g., 10000000"
                  className={errors.estimatedValueOfAssets ? 'border-destructive' : ''}
                />
                {errors.estimatedValueOfAssets && <p className="text-sm text-destructive">{errors.estimatedValueOfAssets}</p>}
              </div>
            </div>
            <p className="text-sm text-muted-foreground">
              Leave financial fields empty if you prefer not to disclose this information
            </p>
          </div>
        </CardContent>
      </Card>

      {mode === 'edit' && modifiedSections.has(SECTIONS.FORMALIZATION) && (
        <div className="flex justify-end">
          <Button onClick={handleSaveFormalization} disabled={isLoading}>
            <Save className="h-4 w-4 mr-2" />
            Save Formalization Information
          </Button>
        </div>
      )}
    </div>
  );

  // Render additional members section
  const renderAdditionalMembersSection = () => (
    <div className="space-y-6">
      <Card>
        <CardHeader>
          <CardTitle>Additional Business Members</CardTitle>
          <CardDescription>
            Add team members (optional). You can skip this step if there are no additional members.
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-6">
          <Tabs value={memberActiveTab} onValueChange={setMemberActiveTab} className="w-full">
            <TabsList className="grid w-full" style={{ gridTemplateColumns: `repeat(${additionalMembers.length + 1}, 1fr)` }}>
              {additionalMembers.map((member, index) => (
                <TabsTrigger key={`member-${index}`} value={`member-${index}`}>
                  <span className="truncate max-w-[120px]">
                    {member.firstName} {member.lastName}
                  </span>
                </TabsTrigger>
              ))}
              <TabsTrigger value="new-member">
                <Plus className="h-4 w-4 mr-1" />
                Add New
              </TabsTrigger>
            </TabsList>

            {additionalMembers.map((member, index) => (
              <TabsContent key={`member-${index}`} value={`member-${index}`} className="space-y-4">
                <Card>
                  <CardHeader className="pb-4">
                    <div className="flex justify-between items-start">
                      <div>
                        <CardTitle className="text-lg">{member.firstName} {member.lastName}</CardTitle>
                        <div className="flex gap-2 mt-2">
                          {member.isIntern && <Badge variant="secondary">Intern</Badge>}
                          {member.isPartTime && <Badge variant="outline">Part Time</Badge>}
                        </div>
                      </div>
                      <Button
                        type="button"
                        variant="ghost"
                        size="sm"
                        onClick={() => removeMember(index)}
                        title="Remove member"
                      >
                        <Trash2 className="h-4 w-4 text-destructive" />
                      </Button>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <div className="grid grid-cols-2 gap-4 text-sm">
                      <div>
                        <p className="text-muted-foreground">National ID</p>
                        <p className="font-medium">{member.nationalIdNumber}</p>
                      </div>
                      <div>
                        <p className="text-muted-foreground">Phone</p>
                        <p className="font-medium">{member.phoneNumber}</p>
                      </div>
                      {member.email && (
                        <div>
                          <p className="text-muted-foreground">Email</p>
                          <p className="font-medium">{member.email}</p>
                        </div>
                      )}
                      {member.nationality && (
                        <div>
                          <p className="text-muted-foreground">Nationality</p>
                          <p className="font-medium">{member.nationality}</p>
                        </div>
                      )}
                      {member.dateOfBirth && (
                        <div>
                          <p className="text-muted-foreground">Date of Birth</p>
                          <p className="font-medium">{new Date(member.dateOfBirth).toLocaleDateString()}</p>
                        </div>
                      )}
                    </div>
                  </CardContent>
                </Card>
              </TabsContent>
            ))}

            <TabsContent value="new-member" className="space-y-4">
              <Card>
                <CardHeader>
                  <CardTitle className="text-lg">New Team Member</CardTitle>
                  <CardDescription>Fill in the details to add a new team member</CardDescription>
                </CardHeader>
                <CardContent>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div className="space-y-2">
                      <Label htmlFor="memberFirstName">First Name *</Label>
                      <Input
                        id="memberFirstName"
                        value={newMember.firstName}
                        onChange={(e) => setNewMember({ ...newMember, firstName: e.target.value })}
                        placeholder="Enter first name"
                      />
                    </div>

                    <div className="space-y-2">
                      <Label htmlFor="memberLastName">Last Name *</Label>
                      <Input
                        id="memberLastName"
                        value={newMember.lastName}
                        onChange={(e) => setNewMember({ ...newMember, lastName: e.target.value })}
                        placeholder="Enter last name"
                      />
                    </div>

                    <div className="space-y-2">
                      <Label htmlFor="memberOtherNames">Other Names</Label>
                      <Input
                        id="memberOtherNames"
                        value={newMember.otherNames}
                        onChange={(e) => setNewMember({ ...newMember, otherNames: e.target.value })}
                        placeholder="Enter other names"
                      />
                    </div>

                    <div className="space-y-2">
                      <Label htmlFor="memberNationality">Nationality</Label>
                      <Select
                        value={newMember.nationality}
                        onValueChange={(value) => setNewMember({ ...newMember, nationality: value })}
                      >
                        <SelectTrigger>
                          <SelectValue placeholder="Select nationality" />
                        </SelectTrigger>
                        <SelectContent>
                          {NATIONALITY_OPTIONS.map((nationality) => (
                            <SelectItem key={nationality.value} value={nationality.value}>
                              {nationality.label}
                            </SelectItem>
                          ))}
                        </SelectContent>
                      </Select>
                    </div>

                    <div className="space-y-2">
                      <Label htmlFor="memberNationalIdNumber">National ID *</Label>
                      <Input
                        id="memberNationalIdNumber"
                        value={newMember.nationalIdNumber}
                        onChange={(e) => setNewMember({ ...newMember, nationalIdNumber: e.target.value })}
                        placeholder="Enter national ID"
                      />
                    </div>

                    <div className="space-y-2">
                      <Label htmlFor="memberDateOfBirth">Date of Birth</Label>
                      <Input
                        id="memberDateOfBirth"
                        type="date"
                        value={newMember.dateOfBirth}
                        onChange={(e) => setNewMember({ ...newMember, dateOfBirth: e.target.value })}
                      />
                    </div>

                    <div className="space-y-2">
                      <Label htmlFor="memberEmail">Email</Label>
                      <Input
                        id="memberEmail"
                        type="email"
                        value={newMember.email}
                        onChange={(e) => setNewMember({ ...newMember, email: e.target.value })}
                        placeholder="Enter email"
                      />
                    </div>

                    <div className="space-y-2">
                      <Label htmlFor="memberPhoneNumber">Phone Number *</Label>
                      <Input
                        id="memberPhoneNumber"
                        value={newMember.phoneNumber}
                        onChange={(e) => setNewMember({ ...newMember, phoneNumber: e.target.value })}
                        placeholder="Enter phone"
                      />
                    </div>

                    <div className="flex items-center space-x-2">
                      <Checkbox
                        id="memberIsIntern"
                        checked={newMember.isIntern}
                        onCheckedChange={(checked) => setNewMember({ ...newMember, isIntern: checked as boolean })}
                      />
                      <Label htmlFor="memberIsIntern" className="cursor-pointer">Is Intern</Label>
                    </div>

                    <div className="flex items-center space-x-2">
                      <Checkbox
                        id="memberIsPartTime"
                        checked={newMember.isPartTime}
                        onCheckedChange={(checked) => setNewMember({ ...newMember, isPartTime: checked as boolean })}
                      />
                      <Label htmlFor="memberIsPartTime" className="cursor-pointer">Is Part Time</Label>
                    </div>
                  </div>

                  <Button
                    type="button"
                    onClick={addMember}
                    disabled={!newMember.firstName || !newMember.lastName || !newMember.nationalIdNumber || !newMember.phoneNumber}
                    className="w-full mt-6"
                  >
                    <Plus className="h-4 w-4 mr-2" />
                    Add Team Member
                  </Button>
                </CardContent>
              </Card>
            </TabsContent>
          </Tabs>
        </CardContent>
      </Card>
    </div>
  );

  // Render review section (create mode only)
  const renderReviewSection = () => (
    <div className="space-y-6">
      <Card>
        <CardHeader>
          <CardTitle>Review Your Information</CardTitle>
          <CardDescription>Please review all information before submitting</CardDescription>
        </CardHeader>
        <CardContent className="space-y-6">
          {/* Business Information Section */}
          <div>
            <h3 className="font-semibold mb-3 flex items-center gap-2">
              <Building2 className="h-5 w-5" />
              Business Information
            </h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2 text-sm">
              <div className="flex justify-between">
                <span className="text-muted-foreground">Business Name:</span>
                <span className="font-medium text-right">{businessData.name || '-'}</span>
              </div>
              {businessData.registrationNumber && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Registration Number:</span>
                  <span className="font-medium text-right">{businessData.registrationNumber}</span>
                </div>
              )}
              {businessData.taxIdentificationNumber && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Tax ID (TIN):</span>
                  <span className="font-medium text-right">{businessData.taxIdentificationNumber}</span>
                </div>
              )}
              <div className="flex justify-between">
                <span className="text-muted-foreground">Category:</span>
                <span className="font-medium text-right">{businessData.businessCategory || '-'}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-muted-foreground">Sector:</span>
                <span className="font-medium text-right">{businessData.sector || '-'}</span>
              </div>
              {businessData.subSector && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Sub Sector:</span>
                  <span className="font-medium text-right">{businessData.subSector}</span>
                </div>
              )}
              {businessData.operationalStartDate && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Operational Since:</span>
                  <span className="font-medium text-right">
                    {new Date(businessData.operationalStartDate).toLocaleDateString()}
                  </span>
                </div>
              )}
              <div className="flex justify-between">
                <span className="text-muted-foreground">Contact Phone:</span>
                <span className="font-medium text-right">{businessData.contactPhone || '-'}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-muted-foreground">Contact Email:</span>
                <span className="font-medium text-right">{businessData.contactEmail || '-'}</span>
              </div>
              {businessData.website && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Website:</span>
                  <span className="font-medium text-right">{businessData.website}</span>
                </div>
              )}
              {businessData.district && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">District:</span>
                  <span className="font-medium text-right">{businessData.district}</span>
                </div>
              )}
              {businessData.traditionalAuthority && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Traditional Authority:</span>
                  <span className="font-medium text-right">{businessData.traditionalAuthority}</span>
                </div>
              )}
            </div>

            {/* Business Description */}
            {businessData.businessDescription && (
              <div className="mt-3 pt-3 border-t">
                <p className="text-sm text-muted-foreground mb-1">Business Description:</p>
                <p className="text-sm">{businessData.businessDescription}</p>
              </div>
            )}

            {/* Addresses */}
            {(businessData.physicalAddress || businessData.postalAddress) && (
              <div className="mt-3 pt-3 border-t grid grid-cols-1 md:grid-cols-2 gap-4">
                {businessData.physicalAddress && (
                  <div>
                    <p className="text-sm text-muted-foreground mb-1">Physical Address:</p>
                    <p className="text-sm">{businessData.physicalAddress}</p>
                  </div>
                )}
                {businessData.postalAddress && (
                  <div>
                    <p className="text-sm text-muted-foreground mb-1">Postal Address:</p>
                    <p className="text-sm">{businessData.postalAddress}</p>
                  </div>
                )}
              </div>
            )}

            {/* Improvement Aspects and Financing */}
            {(businessData.businessImprovementAspects?.length > 0 || businessData.businessAccessedFinancing?.length > 0) && (
              <div className="mt-3 pt-3 border-t space-y-3">
                {businessData.businessImprovementAspects?.length > 0 && (
                  <div>
                    <p className="text-sm text-muted-foreground mb-2">Business Improvement Aspects:</p>
                    <div className="flex flex-wrap gap-1">
                      {businessData.businessImprovementAspects.map((aspect, i) => (
                        <Badge key={i} variant="secondary" className="text-xs">
                          {aspect}
                        </Badge>
                      ))}
                    </div>
                  </div>
                )}
                {businessData.businessAccessedFinancing?.length > 0 && (
                  <div>
                    <p className="text-sm text-muted-foreground mb-2">Financing Sources:</p>
                    <div className="flex flex-wrap gap-1">
                      {businessData.businessAccessedFinancing.map((source, i) => (
                        <Badge key={i} variant="outline" className="text-xs">
                          {source}
                        </Badge>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>

          <Separator />

          {/* Primary Owner Section */}
          <div>
            <h3 className="font-semibold mb-3 flex items-center gap-2">
              <User className="h-5 w-5" />
              Primary Business Owner
            </h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2 text-sm">
              <div className="flex justify-between">
                <span className="text-muted-foreground">Full Name:</span>
                <span className="font-medium text-right">
                  {primaryOwner.firstName} {primaryOwner.lastName}
                  {primaryOwner.otherNames && ` ${primaryOwner.otherNames}`}
                </span>
              </div>
              <div className="flex justify-between">
                <span className="text-muted-foreground">National ID:</span>
                <span className="font-medium text-right">{primaryOwner.nationalIdNumber || '-'}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-muted-foreground">Nationality:</span>
                <span className="font-medium text-right">{primaryOwner.nationality || '-'}</span>
              </div>
              {primaryOwner.dateOfBirth && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Date of Birth:</span>
                  <span className="font-medium text-right">
                    {new Date(primaryOwner.dateOfBirth).toLocaleDateString()}
                  </span>
                </div>
              )}
              <div className="flex justify-between">
                <span className="text-muted-foreground">Gender:</span>
                <span className="font-medium text-right">{primaryOwner.gender || '-'}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-muted-foreground">Education Level:</span>
                <span className="font-medium text-right">{primaryOwner.educationLevel || '-'}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-muted-foreground">Malawian Status:</span>
                <span className="font-medium text-right">{primaryOwner.malawianStatus || '-'}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-muted-foreground">Special Needs:</span>
                <span className="font-medium text-right">{primaryOwner.hasSpecialNeeds ? 'Yes' : 'No'}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-muted-foreground">Phone Number:</span>
                <span className="font-medium text-right">{primaryOwner.phoneNumber || '-'}</span>
              </div>
              {primaryOwner.landlineNumber && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Landline:</span>
                  <span className="font-medium text-right">{primaryOwner.landlineNumber}</span>
                </div>
              )}
              {primaryOwner.email && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Email:</span>
                  <span className="font-medium text-right">{primaryOwner.email}</span>
                </div>
              )}
              {primaryOwner.district && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">District:</span>
                  <span className="font-medium text-right">{primaryOwner.district}</span>
                </div>
              )}
              {primaryOwner.traditionalAuthority && (
                <div className="flex justify-between">
                  <span className="text-muted-foreground">Traditional Authority:</span>
                  <span className="font-medium text-right">{primaryOwner.traditionalAuthority}</span>
                </div>
              )}
            </div>

            {/* Owner Addresses */}
            {(primaryOwner.physicalAddress || primaryOwner.postalAddress) && (
              <div className="mt-3 pt-3 border-t grid grid-cols-1 md:grid-cols-2 gap-4">
                {primaryOwner.physicalAddress && (
                  <div>
                    <p className="text-sm text-muted-foreground mb-1">Physical Address:</p>
                    <p className="text-sm">{primaryOwner.physicalAddress}</p>
                  </div>
                )}
                {primaryOwner.postalAddress && (
                  <div>
                    <p className="text-sm text-muted-foreground mb-1">Postal Address:</p>
                    <p className="text-sm">{primaryOwner.postalAddress}</p>
                  </div>
                )}
              </div>
            )}

            {/* Alternative Contact */}
            {(primaryOwner.altContactName || primaryOwner.altContactRelationship || primaryOwner.altContactPhone) && (
              <div className="mt-3 pt-3 border-t">
                <p className="text-sm font-medium mb-2">Alternative Contact</p>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
                  {primaryOwner.altContactName && (
                    <div className="flex justify-between">
                      <span className="text-muted-foreground">Name:</span>
                      <span className="font-medium text-right">{primaryOwner.altContactName}</span>
                    </div>
                  )}
                  {primaryOwner.altContactRelationship && (
                    <div className="flex justify-between">
                      <span className="text-muted-foreground">Relationship:</span>
                      <span className="font-medium text-right">{primaryOwner.altContactRelationship}</span>
                    </div>
                  )}
                  {primaryOwner.altContactPhone && (
                    <div className="flex justify-between">
                      <span className="text-muted-foreground">Phone:</span>
                      <span className="font-medium text-right">{primaryOwner.altContactPhone}</span>
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>

          <Separator />

          {/* Formalization Status Section */}
          <div>
            <h3 className="font-semibold mb-3 flex items-center gap-2">
              <FileText className="h-5 w-5" />
              Formalization Status
            </h3>

            {/* Registration & Compliance */}
            <div className="mb-4">
              <p className="text-sm font-medium mb-2">Registration & Compliance</p>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
                <div className="flex items-center gap-2">
                  <div className={cn(
                    "h-3 w-3 rounded-full",
                    formalizationData.hasBankAccount ? "bg-green-500" : "bg-gray-300"
                  )} />
                  <span className="text-sm">Bank Account</span>
                </div>
                <div className="flex items-center gap-2">
                  <div className={cn(
                    "h-3 w-3 rounded-full",
                    formalizationData.hasTaxClarification ? "bg-green-500" : "bg-gray-300"
                  )} />
                  <span className="text-sm">Tax Certificate</span>
                </div>
                <div className="flex items-center gap-2">
                  <div className={cn(
                    "h-3 w-3 rounded-full",
                    formalizationData.isRegisteredForVat ? "bg-green-500" : "bg-gray-300"
                  )} />
                  <span className="text-sm">VAT Registration</span>
                </div>
                <div className="flex items-center gap-2">
                  <div className={cn(
                    "h-3 w-3 rounded-full",
                    formalizationData.hasExportLicense ? "bg-green-500" : "bg-gray-300"
                  )} />
                  <span className="text-sm">Export License</span>
                </div>
              </div>
            </div>

            {/* Associations & Support */}
            <div className="mb-4">
              <p className="text-sm font-medium mb-2">Associations & Support</p>
              <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                <div className="flex items-center gap-2">
                  <div className={cn(
                    "h-3 w-3 rounded-full",
                    formalizationData.isMemberOfAssociation ? "bg-green-500" : "bg-gray-300"
                  )} />
                  <span className="text-sm">Business Association</span>
                </div>
                <div className="flex items-center gap-2">
                  <div className={cn(
                    "h-3 w-3 rounded-full",
                    formalizationData.isAffiliated ? "bg-green-500" : "bg-gray-300"
                  )} />
                  <span className="text-sm">Affiliated</span>
                </div>
                <div className="flex items-center gap-2">
                  <div className={cn(
                    "h-3 w-3 rounded-full",
                    formalizationData.hasAccessedBds ? "bg-green-500" : "bg-gray-300"
                  )} />
                  <span className="text-sm">BDS Access</span>
                </div>
              </div>
            </div>

            {/* Financial Information */}
            {(formalizationData.annualTurnover || formalizationData.estimatedValueOfAssets) && (
              <div>
                <p className="text-sm font-medium mb-2">Financial Information</p>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                  {formalizationData.annualTurnover && (
                    <div className="flex justify-between">
                      <span className="text-muted-foreground">Annual Turnover:</span>
                      <span className="font-medium">MWK {parseFloat(formalizationData.annualTurnover).toLocaleString()}</span>
                    </div>
                  )}
                  {formalizationData.estimatedValueOfAssets && (
                    <div className="flex justify-between">
                      <span className="text-muted-foreground">Asset Value:</span>
                      <span className="font-medium">MWK {parseFloat(formalizationData.estimatedValueOfAssets).toLocaleString()}</span>
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>

          {/* Additional Members Section */}
          {additionalMembers.length > 0 && (
            <>
              <Separator />
              <div>
                <h3 className="font-semibold mb-3 flex items-center gap-2">
                  <User className="h-5 w-5" />
                  Additional Members ({additionalMembers.length})
                </h3>
                <div className="space-y-3">
                  {additionalMembers.map((member, index) => (
                    <Card key={index} className="p-3">
                      <div className="flex items-start justify-between">
                        <div className="space-y-1">
                          <p className="font-medium">
                            {member.firstName} {member.lastName}
                            {member.otherNames && ` ${member.otherNames}`}
                          </p>
                          <div className="grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-muted-foreground">
                            <span>ID: {member.nationalIdNumber}</span>
                            <span>Phone: {member.phoneNumber}</span>
                            {member.email && <span>Email: {member.email}</span>}
                            {member.nationality && <span>Nationality: {member.nationality}</span>}
                            {member.dateOfBirth && (
                              <span>DOB: {new Date(member.dateOfBirth).toLocaleDateString()}</span>
                            )}
                          </div>
                        </div>
                        <div className="flex gap-1">
                          {member.isIntern && <Badge variant="secondary" className="text-xs">Intern</Badge>}
                          {member.isPartTime && <Badge variant="outline" className="text-xs">Part Time</Badge>}
                        </div>
                      </div>
                    </Card>
                  ))}
                </div>
              </div>
            </>
          )}
        </CardContent>
      </Card>
    </div>
  );

  // Get current section content
  const getCurrentSectionContent = () => {
    if (mode === 'create') {
      const step = WIZARD_STEPS[currentStep - 1];
      switch (step.key) {
        case SECTIONS.BUSINESS_INFO:
          return renderBusinessInfoSection();
        case SECTIONS.PRIMARY_OWNER:
          return renderPrimaryOwnerSection();
        case SECTIONS.FORMALIZATION:
          return renderFormalizationSection();
        case SECTIONS.ADDITIONAL_MEMBERS:
          return renderAdditionalMembersSection();
        case SECTIONS.REVIEW:
          return renderReviewSection();
        default:
          return null;
      }
    } else {
      switch (activeTab) {
        case SECTIONS.BUSINESS_INFO:
          return renderBusinessInfoSection();
        case SECTIONS.PRIMARY_OWNER:
          return renderPrimaryOwnerSection();
        case SECTIONS.FORMALIZATION:
          return renderFormalizationSection();
        case SECTIONS.ADDITIONAL_MEMBERS:
          return renderAdditionalMembersSection();
        default:
          return null;
      }
    }
  };

  return (
    <div className="space-y-6">
      {/* Wizard Progress (Create Mode Only) */}
      {mode === 'create' && (
        <>
          <div className="space-y-2">
            <div className="flex justify-between items-center">
              <div className="space-y-1">
                <h3 className="text-lg font-semibold">{WIZARD_STEPS[currentStep - 1].name}</h3>
                <p className="text-sm text-muted-foreground">{WIZARD_STEPS[currentStep - 1].description}</p>
              </div>
              <Badge variant="outline" className="text-xs">
                Step {currentStep} of {WIZARD_STEPS.length}
              </Badge>
            </div>
            <Progress value={progress} className="h-2" />
          </div>

          <div className="flex justify-between">
            {WIZARD_STEPS.map((step, index) => (
              <div
                key={step.id}
                className={`flex items-center ${index < WIZARD_STEPS.length - 1 ? 'flex-1' : ''}`}
              >
                <div className="flex flex-col items-center">
                  <div
                    className={cn(
                      "w-10 h-10 rounded-full flex items-center justify-center border-2",
                      currentStep > step.id
                        ? 'bg-primary border-primary text-primary-foreground'
                        : currentStep === step.id
                        ? 'border-primary text-primary'
                        : 'border-muted text-muted-foreground'
                    )}
                  >
                    {currentStep > step.id ? (
                      <Check className="h-5 w-5" />
                    ) : (
                      <span className="text-sm font-semibold">{step.id}</span>
                    )}
                  </div>
                  <span className="text-xs mt-2 text-center hidden sm:block">{step.name}</span>
                </div>
                {index < WIZARD_STEPS.length - 1 && (
                  <div className={cn(
                    "flex-1 h-0.5 mx-2",
                    currentStep > step.id ? 'bg-primary' : 'bg-muted'
                  )} />
                )}
              </div>
            ))}
          </div>

          <Separator />
        </>
      )}

      {/* Tabs Navigation (Edit Mode Only) */}
      {mode === 'edit' && (
        <Tabs value={activeTab} onValueChange={(value) => setActiveTab(value as SectionKey)}>
          <TabsList className="grid w-full grid-cols-4">
            {EDIT_TABS.map((tab) => {
              const Icon = tab.icon;
              const isModified = modifiedSections.has(tab.key);
              return (
                <TabsTrigger key={tab.key} value={tab.key} className="relative">
                  <Icon className="h-4 w-4 mr-2" />
                  {tab.name}
                  {isModified && (
                    <span className="absolute -top-1 -right-1 h-2 w-2 bg-primary rounded-full" />
                  )}
                </TabsTrigger>
              );
            })}
          </TabsList>

          <TabsContent value={activeTab} className="mt-6">
            {getCurrentSectionContent()}
          </TabsContent>
        </Tabs>
      )}

      {/* Render content for wizard mode */}
      {mode === 'create' && (
        <form onSubmit={(e) => e.preventDefault()} className="space-y-6">
          {getCurrentSectionContent()}

          {/* Navigation Buttons */}
          <div className="flex justify-between pt-4 border-t">
            <Button
              type="button"
              variant="outline"
              onClick={handlePrevious}
              disabled={currentStep === 1 || isLoading}
            >
              <ChevronLeft className="h-4 w-4 mr-2" />
              Previous
            </Button>

            {currentStep < WIZARD_STEPS.length ? (
              <Button
                type="button"
                onClick={handleNext}
                disabled={isLoading}
              >
                Next
                <ChevronRight className="h-4 w-4 ml-2" />
              </Button>
            ) : (
              <Button
                type="button"
                onClick={handleCreateSubmit}
                disabled={isLoading}
              >
                {isLoading ? 'Creating...' : 'Create SME'}
              </Button>
            )}
          </div>
        </form>
      )}

      {/* Global Save Button (Edit Mode) */}
      {mode === 'edit' && modifiedSections.size > 0 && (
        <div className="fixed bottom-6 right-6 z-50">
          <Button
            size="lg"
            onClick={handleSaveAllChanges}
            disabled={isLoading}
            className="shadow-lg"
          >
            <Save className="h-5 w-5 mr-2" />
            Save All Changes ({modifiedSections.size})
          </Button>
        </div>
      )}
    </div>
  );
});

SmeUnifiedForm.displayName = 'SmeUnifiedForm';